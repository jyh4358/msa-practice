# deploy/compose/.env 로 복사해서 사용(.env 는 gitignore됨).
#   cp deploy/compose/.env.example deploy/compose/.env
#
# config-service 가 {cipher} DB 비밀번호를 복호화하는 대칭키.
# 주의: 이 리포의 config-repo/*.yml 에 커밋된 {cipher} 값은 아래 "dev 키"로 암호화돼 있다.
#       그래서 학습 재현을 위해 이 값을 그대로 쓴다. (실제 운영에선 키를 절대 커밋/공유하지 않는다.)
ENCRYPT_KEY=shopsaga-dev-encrypt-key-0123456789ab
